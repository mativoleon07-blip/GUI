{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: g++ build active file",
            "type": "shell",
            "command": "g++ -fdiagnostics-color=always -g -std=c++17 $(pkg-config --cflags Qt6Widgets) \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" $(pkg-config --libs Qt6Widgets)",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
